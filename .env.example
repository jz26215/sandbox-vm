# 复制成 .env 再改：cp .env.example .env

# 沙箱时区（IANA 名称）。改完运行 ./sb.sh tz <时区>
SANDBOX_TZ=UTC
# 允许 HTTPS(CONNECT) 的端口，空格分隔
ALLOW_PORTS="443"
# 上游代理（沙箱唯一的出口）：
#   auto:7890      = 自动找 Windows 主机 IP（WSL 为 NAT 模式时）+ 你的代理端口；代理软件要开「允许局域网连接」
#   172.x.x.x:7890 = 直接写 IP:端口
#   留空            = proxy 容器直连（装了网络加固后则全部拒绝）
UPSTREAM_PROXY=auto:7890
# 操作记录（%Y-%m 会换成年-月）
MEMORY_LOG=./ops.md
# 参考时钟（./sb.sh clock，只显示另一个时区的时间和是否工作时段，不改沙箱）
REF_TZ=America/Los_Angeles
REF_PEAK=9-18
# 沙箱资源上限
SANDBOX_CPUS=2.0
SANDBOX_MEM=2g
